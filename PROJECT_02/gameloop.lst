   348                                  ;-------------------------------------------------------
   349                                  ;---------------Collision Detection (Attacked)----------
   350                                  ; This procedure is used for collision detection
   351                                  ;-------------------------------------------------------
   352                                  collision:
   353 00000348 4831DB                      xor     rbx, rbx                    ; clear ebx
   354 0000034B BB64000000                  mov     rbx, MINE_LOC               ; move ordinace location into ebx
   355 00000350 4883FB64                    cmp     rbx, 0x64                   ; compare value in register with 0x64 100,ebx IS( X == 100)?
   356 00000354 751F                    	jne     collision_miss              ; COLLISION_MISS IF X IS NOT EQUAL TO 100, OTHERWISW HIT
   357                                  collision_hit:
   358 00000356 E80CFDFFFF                  call    write_endl                  ; write ENDL
   359 0000035B 48B9-                       mov     rcx, hit_msg                ; message 64 Bit Register
   359 0000035D [D001000000000000] 
