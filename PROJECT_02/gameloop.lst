   361 0000036A E8DEFCFFFF                  call    sys_write                   ; call sys_write   
   362 0000036F E8F3FCFFFF                  call    write_endl                  ; write ENDL
   363 00000374 C3                          ret                                 ; RETURN FROM COLLISION: SUBROUTINE
   364                                  
