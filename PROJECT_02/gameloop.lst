    45                                  _start: ;linker entry point
    46 00000000 E8AE030000                  call    clear_screen                ; CLEARS THE SCREEN 
    47 00000005 E872000000                  call    initialize                  ; Initialize Game Data
    48 0000000A E804040000                  call    red_terminal                ; Red Terminal
    49 0000000F E886000000                  call    welcome                     ; Branch to Welcome Procedure
    50 00000014 E8AF030000                  call    continue                    ; Press anykey to continue
    51 00000019 E895030000                  call    clear_screen                ; CLEARS THE SCREEN 
    52 0000001E E824040000                  call    blue_terminal               ; Blue Terminal
    53 00000023 E896000000                  call    game_input                  ; Branch to Game Input Procedure
    54 00000028 E89B030000                  call    continue                    ; Press anykey to continue 
    55 0000002D E8C7030000                  call    default_terminal            ; Default Terminal
    56 00000032 E802010000                  call    game                        ; Branch to Game Procedure
    57 00000037 E8A1030000                  call    flush                       ; Flush before exit
    58 0000003C E800000000                  call    system_exit                 ; Exit and Clean Up
    59                                  
    60                                  ;-------------------------------------------------------
    61                                  ;--------------------System Exit------------------------
    62                                  ;-------------------------------------------------------
    63                                  system_exit:
    64 00000041 BB00000000                  mov     rbx, STATUS_OK              ; return status 64 Bit Registerr
    65 00000046 B801000000                  mov     rax, SYS_EXIT               ; system call number (sys_exit) 64 Bit Register
    66 0000004B CD80                        int     SYS_KERNEL                  ; call kernel, system call 64 bit System  
    67                                  
    68                                  ;-------------------------------------------------------
    69                                  ;-------------------Write to stdout---------------------
    70                                  ;-------------------------------------------------------
    71                                  sys_write:
    72 0000004D BB01000000                  mov     rbx, SYS_STDOUT             ; file descriptor (stdout) 64 Bit Register
