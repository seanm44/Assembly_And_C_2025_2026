   193                                  update:
   194 0000018B E8D7FEFFFF                  call    write_endl                  ; write ENDL
   195 00000190 48B9-                       mov     rcx, update_msg             ; message 64 Bit Register
   195 00000192 [B201000000000000] 
   196 0000019A BA11000000                  mov     rdx, len_update_msg         ; message length see length equ 64 Bit Register
   197 0000019F E8A9FEFFFF                  call    sys_write                   ; call sys_write   
   198 000001A4 E8BEFEFFFF                  call    write_endl                  ; write ENDL
   199                                  
   200 000001A9 E806000000                  call    .update_score               ; update score    
   201 000001AE E82F000000                  call    .update_health              ; update health 
   202                                  
   203 000001B3 C3                          ret                                 ; RETURN FROM UPDATE: SUBROUTINE
   204                                  
   205                                  .update_score:
   206 000001B4 31C0                        xor     eax, eax                    ; clear eax accumulator register
   207 000001B6 8B0425[03000000]            mov     eax, [score]                ; fetch score
   208                                     
   209 000001BD 89C1                        mov     ecx, eax                    ; move to ecx for comparison
   210 000001BF 81F9AC260000                cmp     ecx, SCORE_VAL              ; Check is score is less than SCORE_VAL
   211 000001C5 7C0E                        jl      .set_score                  ; set score 
   212                                  .set_score_max:    
   213 000001C7 B80F270000                  mov     eax, MAX_SCORE              ; set score to MAX_SCORE
   214 000001CC 890425[03000000]            mov     [score], eax                ; update score
   215 000001D3 EB0C                        jmp     .end_update_score           ; goto end or procedure
   216                                  .set_score:
   217 000001D5 83C064                      add     eax, SCORE_INC              ; increment score by SCORE_INC per round
   218 000001D8 890425[03000000]            mov     [score], eax                ; update score
   219 000001DF EB00                        jmp     .end_update_score           ; goto end or procedure
   220                                  .end_update_score:
   221 000001E1 C3                          ret                                 ; return
   222                                      
   223                                  .update_health:
   224 000001E2 31C0                        xor     eax, eax                    ; clear eax accumulator register
   225 000001E4 8B0425[07000000]            mov     eax, [health]               ; fetch health
   226                                      
   227 000001EB 89C1                        mov     ecx, eax
   228 000001ED 83F90A                      cmp     ecx, LOSE_HEALTH            ; Check is health remaining is greater than LOSE_HEALTH
   229 000001F0 7D0E                        jge     .set_health                 ; set health
   230                                  .set_health_zero:    
   231 000001F2 B800000000                  mov     eax, MIN_HEALTH             ; set health to 0
   232 000001F7 890425[07000000]            mov     [health], eax               ; update health
   233 000001FE EB0C                        jmp     .end_update_health          ; goto end or procedure
   234                                  .set_health:
   235 00000200 83E80A                      sub     eax, LOSE_HEALTH            ; decrement health by 10 per round (TODO Change GSM when Health reached 0)
   236 00000203 890425[07000000]            mov     [health], eax               ; update health
   237 0000020A EB00                        jmp     .end_update_health          ; goto end or procedure
   238                                  .end_update_health:
   239 0000020C C3                          ret                                 ; return
