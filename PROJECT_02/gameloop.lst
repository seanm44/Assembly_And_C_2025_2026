   367 0000037A 48B9-                       mov     rcx, miss_msg               ; message 64 Bit Register
   367 0000037C [D701000000000000] 
   368 00000384 BA05000000                  mov     rdx, len_miss_msg           ; message length see length equ 64 Bit Register
   369 00000389 E8BFFCFFFF                  call    sys_write                   ; call sys_write   
   370 0000038E E8D4FCFFFF                  call    write_endl                  ; write ENDL
   371 00000393 C3                          ret                                 ; RETURN FROM COLLISION: SUBROUTINE   
   372                                  
   373                                  ;-------------------------------------------------------
   374                                  ;----Convert Number into Printable String---------------
   375                                  ; Step through each digit and display
   376                                  ;-------------------------------------------------------
   377                                  int_to_string:
   378 00000394 83C609                      add     esi, 9                      ; 0-9 Bytes    
   379 00000397 67C60600                    mov     byte [esi], 0               ; String terminator
   380                                      
   381 0000039B BB0A000000                  mov     ebx, 10                     ; Move 10 (divide each digit by 10)
   382                                  
   383                                  .next_digit:
   384 000003A0 31D2                        xor     edx, edx                    ; clear edx register
   385 000003A2 F7F3                        div     ebx                         ; eax /= 10
   386 000003A4 80C230                      add     dl, '0'                     ; Convert the remainder to ASCII 
   387 000003A7 FFCE                        dec     esi                         ; Store characters in reverse order
   388 000003A9 678816                      mov     [esi], dl                   ; Move DL register to ESI
   389 000003AC 85C0                        test    eax, eax                    ; Perform a bitwise AND on two operands                   
   390 000003AE 75F0                        jnz     .next_digit                 ; Repeat until eax == 0
   391 000003B0 89F0                        mov     eax, esi                    ; Memory address of first Digit
   392 000003B2 C3                          ret
   393                                  
   394                                  ;-------------------------------------------------------
   395                                  ;------------------CLEAR SCREEN-------------------------
   396                                  ;-------------------------------------------------------
   397                                  clear_screen:
   398 000003B3 48B9-                       mov     rcx, clear_escape           ; Terminal control string
   398 000003B5 [0000000000000000] 
   399 000003BD BA07000000                  mov     rdx, len_clear_escape       ; clear_escape message length
   400 000003C2 E886FCFFFF                  call    sys_write                   ; call sys_write
   401 000003C7 C3                          ret
   402                                  
