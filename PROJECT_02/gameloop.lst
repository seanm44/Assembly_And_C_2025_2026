   409 000003D7 E87EFCFFFF                  call    sys_read                    ; call sys_read
   410 000003DC C3                          ret                                 ; return
   411                                  
   412                                  ;-------------------------------------------------------
   413                                  ;------------------Flush Line Feed----------------------
   414                                  ;-------------------------------------------------------
   415                                  flush:
   416 000003DD 48B9-                       mov     rcx, flush_buffer           ; message 64 Bit Register
   416 000003DF [1300000000000000] 
   417 000003E7 BA01000000                  mov     rdx, len_flush_buffer       ; message length see length equ 64 Bit Register
   418 000003EC E869FCFFFF                  call    sys_read                    ; call sys_read
   419 000003F1 807C11FF0A                  cmp     byte [rcx + rdx - 1], 0xA   ; cmp line feed
   420 000003F6 75E5                        jne     flush                       ; loop again
   421 000003F8 C3                          ret                                 ; return
